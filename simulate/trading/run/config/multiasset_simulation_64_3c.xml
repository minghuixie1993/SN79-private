<!--
  The 0.6.5 three-class layout at half size: 2 realizations of simulation_0 (books 0-31), 1 of simulation_1 (32-47)
  and 1 of simulation_2 (48-63), sixteen books each, 64 books in all, for running several local validators at once
  (agents/network). Same class shares of the books as multiasset_simulation_0.xml (0.50 / 0.25 / 0.25), and the
  coarsest grid first, as every layout must.
-->
<MultiAssetSimulation
    traceTime="1"
    measureStepWallClockTime="1"
    useMessagePack="1"
    host="localhost"
    port="8000"
    generalMsgEndpoint="/account"
    threads="8"
    start="0"
    step="1000000000"
    duration="86400000000000"
    gracePeriod="600000000000"
    ckptIntervalInSteps="600"
    ckptNumLastFilesToKeep="3"
    ckptNumWorkers="4"
    ckptMeasureWallClockTime="1">

    <Background name="simulation_0" path="simulation_0.xml" instanceCount="2"/>
    <Background name="simulation_1" path="simulation_1.xml" instanceCount="1"/>
    <Background name="simulation_2" path="simulation_2.xml" instanceCount="1"/>

</MultiAssetSimulation>
