<!--
  A smaller multiasset_simulation_0: 3 realization(s) of simulation_0 and 1 of simulation_1, sixteen books each,
  64 books in all, for running several local validators at once (agents/network). Same backgrounds and grid.
-->
<MultiAssetSimulation
    traceTime="1"
    measureStepWallClockTime="1"
    useMessagePack="1"
    host="localhost"
    port="8000"
    generalMsgEndpoint="/account"
    threads="8"
    start="0"
    step="1000000000"
    duration="86400000000000"
    gracePeriod="600000000000"
    ckptIntervalInSteps="600"
    ckptNumLastFilesToKeep="3"
    ckptNumWorkers="4"
    ckptMeasureWallClockTime="1">

    <Background name="simulation_0" path="simulation_0.xml" instanceCount="3"/>
    <Background name="simulation_1" path="simulation_1.xml" instanceCount="1"/>

</MultiAssetSimulation>
